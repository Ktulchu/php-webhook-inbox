{
  "name": "ktulchu/php-webhook-inbox",
  "description": "Reliable transactional webhook inbox for PHP and PostgreSQL",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Ktulchu\\WebhookInbox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ktulchu\\WebhookInbox\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
