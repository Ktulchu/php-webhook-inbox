{
  "name": "ktulchu/php-webhook-inbox",
  "description": "Framework-independent transactional PostgreSQL webhook inbox for PHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*"
  },
  "suggest": {
    "ext-pdo": "Required by PdoAdapter and the bundled demo",
    "ext-pdo_pgsql": "Required by PdoAdapter with PostgreSQL",
    "yiisoft/yii2": "Required only for Yii2Adapter",
    "doctrine/dbal": "Required only for DoctrineAdapter (DBAL 4)"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "Ktulchu\\WebhookInbox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ktulchu\\WebhookInbox\\Tests\\": "tests/",
      "Ktulchu\\WebhookInbox\\Example\\": "examples/basic/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
